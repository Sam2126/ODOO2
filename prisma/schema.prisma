// StockSense — inventory management.
//
// The model is deliberately Odoo-shaped: every change in stock is a StockMove
// from one Location to another. Vendors, customers and inventory losses are
// modelled as virtual Locations, so receipts, deliveries, internal transfers and
// adjustments are all the same operation with different endpoints. On-hand stock
// is therefore never stored on Product — it is the sum of StockQuant rows over
// locations of type INTERNAL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  STAFF
}

enum Uom {
  UNIT
  KG
  LITRE
  METRE
  BOX
  PACK
}

enum LocationType {
  INTERNAL // a real place that holds stock: a warehouse, a rack, a production floor
  VENDOR // virtual: where incoming goods come from
  CUSTOMER // virtual: where outgoing goods go
  ADJUSTMENT // virtual: the counterpart of a stock correction
  TRANSIT // virtual: in flight between two warehouses
}

enum PickingType {
  RECEIPT
  DELIVERY
  INTERNAL
}

enum DocStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  otps        PasswordOtp[]
  pickings    Picking[]
  adjustments Adjustment[]
  moves       StockMove[]

  @@map("users")
}

model PasswordOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String // bcrypt digest, the six digits are never stored
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_otps")
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // "WH", the prefix in WH/IN/00001
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations    Location[]
  pickings     Picking[]
  reorderRules ReorderRule[]

  @@map("warehouses")
}

model Location {
  id          String       @id @default(cuid())
  name        String // "WH/Stock", "Partners/Vendors"
  code        String
  type        LocationType @default(INTERNAL)
  warehouseId String? // null for virtual locations
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  quants       StockQuant[]
  movesOut     StockMove[]  @relation("moveSource")
  movesIn      StockMove[]  @relation("moveDest")
  pickingsFrom Picking[]    @relation("pickSource")
  pickingsTo   Picking[]    @relation("pickDest")
  adjustments  Adjustment[]

  @@unique([warehouseId, code])
  @@index([type])
  @@map("locations")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  products Product[]

  @@map("categories")
}

model Product {
  id         String    @id @default(cuid())
  name       String
  sku        String    @unique
  uom        Uom       @default(UNIT)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costPrice  Decimal?  @db.Decimal(12, 2)
  salePrice  Decimal?  @db.Decimal(12, 2)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  quants          StockQuant[]
  moves           StockMove[]
  pickingLines    PickingLine[]
  adjustmentLines AdjustmentLine[]
  reorderRules    ReorderRule[]

  @@index([name])
  @@index([sku])
  @@map("products")
}

model ReorderRule {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  minQty      Decimal   @default(0) @db.Decimal(14, 3)
  maxQty      Decimal   @default(0) @db.Decimal(14, 3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@map("reorder_rules")
}

/// On-hand quantity of one product in one location. Written only by applyMove.
model StockQuant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([locationId])
  @@map("stock_quants")
}

/// Receipts, delivery orders and internal transfers are one document type.
/// They differ only by type and by which locations they point at.
model Picking {
  id               String      @id @default(cuid())
  reference        String      @unique // WH/IN/00001
  type             PickingType
  status           DocStatus   @default(DRAFT)
  partnerName      String? // supplier on a receipt, customer on a delivery
  sourceLocationId String
  sourceLocation   Location    @relation("pickSource", fields: [sourceLocationId], references: [id])
  destLocationId   String
  destLocation     Location    @relation("pickDest", fields: [destLocationId], references: [id])
  warehouseId      String
  warehouse        Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  scheduledAt      DateTime    @default(now())
  // A delivery is picked off the shelf, then packed, then validated — the
  // three steps the problem statement describes. They are progress markers
  // inside READY rather than extra statuses, because the status list the
  // dashboard filters by is fixed at Draft/Waiting/Ready/Done/Canceled.
  pickedAt         DateTime?
  packedAt         DateTime?
  validatedAt      DateTime?
  note             String?
  createdById      String
  createdBy        User        @relation(fields: [createdById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  lines PickingLine[]
  moves StockMove[]

  @@index([type, status])
  @@index([warehouseId])
  @@map("pickings")
}

model PickingLine {
  id        String  @id @default(cuid())
  pickingId String
  picking   Picking @relation(fields: [pickingId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  demandQty Decimal @db.Decimal(14, 3)
  doneQty   Decimal @default(0) @db.Decimal(14, 3)

  @@unique([pickingId, productId])
  @@map("picking_lines")
}

model Adjustment {
  id          String    @id @default(cuid())
  reference   String    @unique // ADJ/00001
  status      DocStatus @default(DRAFT)
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id])
  note        String?
  validatedAt DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines AdjustmentLine[]
  moves StockMove[]

  @@index([status])
  @@map("adjustments")
}

model AdjustmentLine {
  id           String     @id @default(cuid())
  adjustmentId String
  adjustment   Adjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  systemQty    Decimal    @default(0) @db.Decimal(14, 3) // snapshot taken at validation
  countedQty   Decimal    @db.Decimal(14, 3)

  @@unique([adjustmentId, productId])
  @@map("adjustment_lines")
}

/// The stock ledger. Append only: rows are never updated or deleted.
model StockMove {
  id               String      @id @default(cuid())
  productId        String
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity         Decimal     @db.Decimal(14, 3)
  sourceLocationId String
  sourceLocation   Location    @relation("moveSource", fields: [sourceLocationId], references: [id])
  destLocationId   String
  destLocation     Location    @relation("moveDest", fields: [destLocationId], references: [id])
  reference        String
  pickingId        String?
  picking          Picking?    @relation(fields: [pickingId], references: [id], onDelete: Cascade)
  adjustmentId     String?
  adjustment       Adjustment? @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        User        @relation(fields: [createdById], references: [id])
  movedAt          DateTime    @default(now())

  @@index([productId, movedAt])
  @@index([movedAt])
  @@map("stock_moves")
}

/// Per-prefix counter for human-readable document references.
/// Incremented atomically inside the same transaction that creates the document,
/// so two people validating at the same moment cannot collide on a reference.
model DocumentSequence {
  prefix String @id // "WH/IN", "WH/OUT", "WH/INT", "ADJ"
  next   Int    @default(1)

  @@map("document_sequences")
}
