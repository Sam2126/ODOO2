# Postgres. `docker compose up -d` serves this exact URL on port 5433.
DATABASE_URL="postgresql://stocksense:stocksense@localhost:5433/stocksense?schema=public"

# Signing key for the session cookie. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# SMTP for password-reset codes. Leave blank in development and the code is
# printed to the server console instead of being emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="StockSense <no-reply@stocksense.local>"
